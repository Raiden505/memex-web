# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Phases 1-4: use the service_role key (never commit it, never ship it in a client)
# Phase 5+: both keys are needed — anon key for CLI + web browser, service key for FastAPI JWT validation
SUPABASE_SERVICE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Embedding model: text-embedding-004 was shut down Jan 2026. Use gemini-embedding-001.
# Chat model: confirm current Flash model ID at https://ai.google.dev/gemini-api/docs/models
CHAT_MODEL=gemma-4-26b-a4b-it
EMBED_MODEL=gemini-embedding-001

# FastAPI CORS — comma-separated origins allowed to call the API (Phase 6+)
ALLOWED_ORIGINS=http://localhost:3000

# Optional — defaults shown
# EMBED_DIM=768
# TOP_K=5
# RECALL_USER_ID=00000000-0000-0000-0000-000000000001
